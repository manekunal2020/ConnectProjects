# Local development only. Replace every value before deployment.
POSTGRES_DB=connect_projects
POSTGRES_USER=connect_projects
POSTGRES_PASSWORD=local-postgres-password-change-me
DATABASE_USERNAME=connect_projects
DATABASE_PASSWORD=local-postgres-password-change-me

BOOTSTRAP_SUPERUSER_USERNAME=superuser
BOOTSTRAP_SUPERUSER_PASSWORD=local-superuser-password-change-me
BOOTSTRAP_SUPERUSER_NAME=Kunal Mane
BOOTSTRAP_SUPERUSER_EMAIL=manekunal2020@gmail.com

JWT_SECRET=local-jwt-signing-secret-change-before-deployment-minimum-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_URL=http://localhost:5173
# Gmail SMTP defaults; change these if you use another mail provider.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Set MAIL_USERNAME to the same address as EMAIL_USER in connect-projects-backend/.env.
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional: defaults to MAIL_USERNAME. Override if your provider uses a different sender address.
MAIL_FROM=
